# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# --- HTTP server ---------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- SQL Server ----------------------------------------------------------
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=TrainingErp
DB_USER=sa
# Quote the value if it contains "#" (dotenv treats an unquoted # as a comment).
DB_PASSWORD="YourStrong!Passw0rd"
# Set to true when connecting to a server that requires TLS (e.g. a managed cloud database).
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# --- Authentication ------------------------------------------------------
# Secret used to sign JWT access tokens (min. 16 characters, required in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset in development, a random secret is generated on every start (sessions end on restart).
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Failed sign-in attempts allowed per window (successful sign-ins are not counted).
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# --- CORS ----------------------------------------------------------------
# Comma-separated browser origins allowed to call the API, e.g. https://erp.example.com
# Leave empty when the front end is served by this server (same origin). "*" allows any origin.
CORS_ORIGINS=

# --- Misc ----------------------------------------------------------------
# Log every HTTP request (default: true, except in tests).
LOG_REQUESTS=true
# Set when running behind a reverse proxy so rate limiting sees the real client IP.
# TRUST_PROXY=true
# Base name for the integration-test databases (the suite appends _auth, _roles, ...).
# TEST_DB_NAME=TrainingErpTest
